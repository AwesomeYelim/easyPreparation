{
  "model": "sonnet",
  "autoCompactWindow": true,
  "permissions": {
    "allow": [
      "Bash(file:*)",
      "Bash(cd:*)",
      "Bash(.claude/bin/indexer:*)",
      "Bash(git:*)",
      "Bash(curl:*)",
      "Bash(go run:*)",
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(make:*)",
      "Bash(npm:*)",
      "Bash(node:*)",
      "Bash(lsof:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(ps:*)",
      "Bash(sleep:*)",
      "Bash(tail:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(chmod:*)",
      "Bash(ls:*)",
      "Bash(export:*)",
      "Bash(unzip:*)",
      "Bash(zip:*)",
      "Bash(sha256sum:*)",
      "Bash(which:*)",
      "Bash(bash tools/setup.sh:*)",
      "Bash(bash tools/hooks/:*)",
      "Bash(bash scripts/push-context.sh)",
      "Bash(npx tsc:*)",
      "Bash(jq:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p \"$CLAUDE_PROJECT_DIR/.claude/bin/output\" && cd \"$CLAUDE_PROJECT_DIR/.claude/bin\" && OS=$(uname -s) && ARCH=$(uname -m) && case \"$OS-$ARCH\" in Linux-x86_64) BIN=indexer-linux-amd64;; Darwin-x86_64) BIN=indexer-darwin-amd64;; Darwin-arm64) BIN=indexer-darwin-arm64;; *) BIN=indexer.exe;; esac && chmod +x ./$BIN 2>/dev/null; ./$BIN -build 2>&1 | tail -2"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/setup.sh\" 2>&1 | tail -8"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && git diff --name-only 2>/dev/null | head -5 | while read f; do [ -n \"$f\" ] && [ -f \"$f\" ] && bash tools/hooks/post-edit-check.sh \"$f\"; done || true",
            "statusMessage": "Anti-pattern check"
          },
          {
            "type": "command",
            "command": "file=$(jq -r '.tool_input.file_path // \"\" | gsub(\"\\\\\\\\\"; \"/\")'); case \"$file\" in *.go) out=$(cd \"$CLAUDE_PROJECT_DIR\" && go vet \"$(dirname \"$file\")\" 2>&1) || { printf '%s\n' \"$out\" | head -15 >&2; exit 2; };; esac; true",
            "statusMessage": "go vet"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/ts-check.sh\"",
            "statusMessage": "tsc"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/visual-regression.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/diff-self-review.sh\""
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80",
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  }
}